# ── Gemini ────────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# ── Notion (optional) ─────────────────────────────────────────────────────────
# If not configured, Notion sync is skipped — data still saved to PostgreSQL
# Integration token from https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...
# The database ID from your "Job Applications" Notion database URL
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Block/page ID of your "Manual Review" Notion page
NOTION_REVIEW_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Slack (optional) ──────────────────────────────────────────────────────────
# Bot token from https://api.slack.com/apps — used for daily digest
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#job-search

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_DB=jobtracker

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme_in_prod
N8N_HOST=localhost
N8N_LICENSE_ACTIVATION_KEY=your-license-key-here

# ── FastAPI (used inside n8n environment) ─────────────────────────────────────
FASTAPI_URL=http://fastapi:8000
